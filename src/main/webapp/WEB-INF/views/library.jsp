<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="titleKey" value="library.title"/><c:set var="mainClass" value="wide"/>
<%@ include file="_header.jspf" %>
<section id="library" class="library" aria-labelledby="library-title">
  <div class="library-shell">
    <aside class="library-rail" aria-label="<fmt:message key='nav.library'/>">
      <span class="library-rail__number" aria-hidden="true">01</span>
      <span class="library-rail__label"><fmt:message key="library.title"/></span>
      <span class="library-rail__rule" aria-hidden="true"></span>
      <span class="library-rail__caption"><fmt:message key="app.kicker"/></span>
    </aside>
    <div class="library-content">
      <div class="page-heading"><div><span class="eyebrow"><fmt:message key="app.title"/></span><h1 id="library-title"><fmt:message key="library.title"/></h1></div><div class="library-toolbar"><a href="${ctx}/import" class="btn primary"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg><fmt:message key="library.import"/></a></div></div>
      <form class="library-controls" method="get" action="${ctx}/home"><label><span class="sr"><fmt:message key="library.search"/></span><input type="search" name="q" value="<c:out value='${query}'/>" placeholder="<fmt:message key='library.search'/>"></label><label><span class="sr"><fmt:message key="library.sort"/></span><select name="sort" onchange="this.form.submit()"><option value="recent" ${sort == 'recent' ? 'selected' : ''}><fmt:message key="library.sort.recent"/></option><option value="added" ${sort == 'added' ? 'selected' : ''}><fmt:message key="library.sort.added"/></option><option value="title" ${sort == 'title' ? 'selected' : ''}><fmt:message key="library.sort.title"/></option></select></label><button type="submit" class="btn small"><fmt:message key="library.search"/></button></form>
      <c:if test="${not empty continueBook and empty query}"><section class="continue-card" aria-labelledby="continue-title"><span class="eyebrow" id="continue-title"><fmt:message key="library.continue"/></span><a href="${ctx}/read?id=${continueBook.id}" class="continue-card__body"><span class="continue-card__cover"><c:choose><c:when test="${continueBook.hasCover}"><img src="${ctx}/books/cover?id=${continueBook.id}" alt=""></c:when><c:otherwise>PDF</c:otherwise></c:choose></span><span><strong><c:out value="${continueBook.title}"/></strong><span><fmt:message key="reader.page"/> ${continueBook.lastPage} / ${continueBook.pageCount}</span></span><span class="continue-card__arrow" aria-hidden="true">→</span></a></section></c:if>
  <c:choose><c:when test="${empty books}"><div class="empty-state"><div class="empty-state__inner"><span class="empty-state__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg></span><p><c:choose><c:when test="${not empty query}"><fmt:message key="library.noResults"/></c:when><c:otherwise><fmt:message key="library.empty"/></c:otherwise></c:choose></p><a href="${ctx}/import" class="btn"><fmt:message key="library.import"/></a></div></div></c:when><c:otherwise><div class="grid"><c:forEach var="b" items="${books}"><article class="book"><a class="cover" href="${ctx}/read?id=${b.id}" aria-label="<c:out value='${b.title}'/>"><c:choose><c:when test="${b.hasCover}"><img src="${ctx}/books/cover?id=${b.id}" alt="" loading="lazy"></c:when><c:otherwise><span class="placeholder" aria-hidden="true">PDF</span></c:otherwise></c:choose><c:if test="${not empty b.lastReadAt}"><span class="bar"><span style="width:${b.progressPercent}%"></span></span></c:if></a><div class="info"><a class="title" href="${ctx}/read?id=${b.id}" title="<c:out value='${b.title}'/>"><c:out value="${b.title}"/></a><div class="sub"><span class="pages"><fmt:message key="reader.page"/> ${b.lastPage} / ${b.pageCount}</span><fmt:message key="book.delete.confirm" var="confirmMsg"><fmt:param value="${b.title}"/></fmt:message><form method="post" action="${ctx}/books/delete" class="delete-form" data-confirm="<c:out value='${confirmMsg}'/>"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrfToken}'/>"><input type="hidden" name="id" value="${b.id}"><button type="submit" class="link danger"><fmt:message key="book.delete"/></button></form></div></div></article></c:forEach></div></c:otherwise></c:choose>
    </div>
  </div>
</section><script src="${ctx}/static/js/library.js" defer></script><%@ include file="_footer.jspf" %>
