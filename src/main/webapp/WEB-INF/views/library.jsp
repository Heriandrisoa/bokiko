<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="titleKey" value="library.title"/><c:set var="mainClass" value="wide"/>
<%@ include file="_header.jspf" %>
<fmt:message key="upload.uploading" var="tUploading"/><fmt:message key="upload.done" var="tDone"/><fmt:message key="upload.refresh" var="tRefresh"/><fmt:message key="upload.network" var="tNetwork"/><fmt:message key="books.error.notPdf" var="tNotPdf"/><fmt:message key="books.error.tooLarge" var="tTooLarge"/><fmt:message key="library.drop.title" var="tDropTitle"/><fmt:message key="library.drop.help" var="tDropHelp"/>
<section id="library" class="library" aria-labelledby="library-title" data-upload-url="${ctx}/books/upload" data-csrf="<c:out value='${sessionScope.csrfToken}'/>" data-max-bytes="104857600" data-msg-uploading="<c:out value='${tUploading}'/>" data-msg-done="<c:out value='${tDone}'/>" data-msg-refresh="<c:out value='${tRefresh}'/>" data-msg-network="<c:out value='${tNetwork}'/>" data-msg-not-pdf="<c:out value='${tNotPdf}'/>" data-msg-too-large="<c:out value='${tTooLarge}'/>">
  <div class="page-heading"><div><span class="eyebrow"><fmt:message key="app.title"/></span><h1 id="library-title"><fmt:message key="library.title"/></h1></div><div class="library-toolbar"><button type="button" id="importBtn" class="btn primary"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg><fmt:message key="library.import"/></button><input type="file" id="fileInput" accept="application/pdf,.pdf" multiple hidden></div></div>
  <div id="uploadStatus" class="upload-status" aria-live="polite"></div>
  <div id="dropZone" class="drop-zone" tabindex="0" role="button" aria-describedby="dropZoneHelp" data-import-trigger><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4"/><path d="m7 9 5-5 5 5"/><path d="M5 20h14"/></svg><span><strong><c:out value="${tDropTitle}"/></strong><span id="dropZoneHelp"><c:out value="${tDropHelp}"/></span></span></div>
  <c:choose><c:when test="${empty books}"><div class="empty-state"><div class="empty-state__inner"><span class="empty-state__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg></span><p><fmt:message key="library.empty"/></p><button type="button" class="btn" data-import-trigger><fmt:message key="library.import"/></button></div></div></c:when><c:otherwise><div class="grid"><c:forEach var="b" items="${books}"><article class="book"><a class="cover" href="${ctx}/read?id=${b.id}" aria-label="<c:out value='${b.title}'/>"><c:choose><c:when test="${b.hasCover}"><img src="${ctx}/books/cover?id=${b.id}" alt="" loading="lazy"></c:when><c:otherwise><span class="placeholder" aria-hidden="true">PDF</span></c:otherwise></c:choose><c:if test="${not empty b.lastReadAt}"><span class="bar"><span style="width:${b.progressPercent}%"></span></span></c:if></a><div class="info"><a class="title" href="${ctx}/read?id=${b.id}" title="<c:out value='${b.title}'/>"><c:out value="${b.title}"/></a><div class="sub"><span class="pages"><fmt:message key="reader.page"/> ${b.lastPage} / ${b.pageCount}</span><fmt:message key="book.delete.confirm" var="confirmMsg"><fmt:param value="${b.title}"/></fmt:message><form method="post" action="${ctx}/books/delete" class="delete-form" data-confirm="<c:out value='${confirmMsg}'/>"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrfToken}'/>"><input type="hidden" name="id" value="${b.id}"><button type="submit" class="link danger"><fmt:message key="book.delete"/></button></form></div></div></article></c:forEach></div></c:otherwise></c:choose>
</section><script src="${ctx}/static/js/library.js" defer></script><%@ include file="_footer.jspf" %>
