</main>
<c:if test="${mainClass != 'reader-page'}">
  <footer class="site-footer">
    <div class="site-footer__inner">
      <span class="site-footer__brand">
        <span class="site-footer__mark" aria-hidden="true"></span>
        <fmt:message key="app.title"/>
      </span>
      <span class="site-footer__copy">&copy; <fmt:message key="app.title"/> &middot; <fmt:message key="app.kicker"/></span>
    </div>
  </footer>
</c:if>
</body>
</html>
