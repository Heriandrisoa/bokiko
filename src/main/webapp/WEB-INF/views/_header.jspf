<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<fmt:setLocale value="${lang}"/><fmt:setBundle basename="i18n.messages"/><c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!DOCTYPE html><html lang="${lang}"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title><c:choose><c:when test="${not empty rawTitle}"><c:out value="${rawTitle}"/></c:when><c:otherwise><fmt:message key="${titleKey}"/></c:otherwise></c:choose> &middot; <fmt:message key="app.title"/></title>
  <link rel="stylesheet" href="${ctx}/static/css/app.css">
  <link rel="stylesheet" href="${ctx}/static/css/cool-theme.css"></head><body>
<header class="app">
  <div class="app-header__inner">
    <a class="brand" href="${ctx}/home" aria-label="<fmt:message key='app.title'/>">
      <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg></span>
      <span class="brand-copy"><span class="brand-kicker"><fmt:message key="app.kicker"/></span><span class="brand-name"><fmt:message key="app.title"/></span></span>
    </a>
    <c:if test="${not empty sessionScope.userId}">
      <nav class="primary-nav" aria-label="<fmt:message key='nav.primary'/>">
        <a href="${ctx}/home" class="nav-link ${currentPage == 'home' ? 'is-active' : ''}"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg><span><fmt:message key="nav.library"/></span></a>
      </nav>
    </c:if>
    <div class="app-actions">
      <c:if test="${not empty sessionScope.username}"><fmt:message key="home.greeting" var="greeting"><fmt:param value="${sessionScope.username}"/></fmt:message><span class="greeting"><c:out value="${greeting}"/></span></c:if>
      <form class="language-form" method="get" action="${ctx}/lang"><input type="hidden" name="next" value="${currentPage}"><c:if test="${currentPage == 'read'}"><input type="hidden" name="id" value="${book.id}"></c:if><label for="lang"><fmt:message key="nav.language"/></label><select id="lang" name="lang" onchange="this.form.submit()"><option value="fr" ${lang == 'fr' ? 'selected' : ''}>Fran&ccedil;ais</option><option value="en" ${lang == 'en' ? 'selected' : ''}>English</option><option value="mg" ${lang == 'mg' ? 'selected' : ''}>Malagasy</option></select><noscript><button type="submit" class="btn small">OK</button></noscript></form>
      <c:if test="${not empty sessionScope.userId}"><form method="post" action="${ctx}/logout"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrfToken}'/>"><button type="submit" class="btn small"><fmt:message key="nav.logout"/></button></form></c:if>
    </div>
  </div>
</header><main class="${mainClass}">
