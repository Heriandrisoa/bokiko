<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="titleKey" value="library.title"/><c:set var="rawTitle" value="${book.title}"/><c:set var="mainClass" value="reader-page"/><%@ include file="_header.jspf" %><fmt:message key="reader.error" var="tError"/><fmt:message key="reader.fullscreen" var="tFullscreen"/><fmt:message key="reader.exitFullscreen" var="tExitFullscreen"/><fmt:message key="reader.search" var="tSearch"/>
<section id="reader" class="reader" aria-label="<c:out value='${book.title}'/>" data-file-url="${ctx}/books/file?id=${book.id}" data-progress-url="${ctx}/books/progress" data-book-id="${book.id}" data-csrf="<c:out value='${sessionScope.csrfToken}'/>" data-start-page="${book.lastPage}" data-msg-error="<c:out value='${tError}'/>" data-msg-fullscreen="<c:out value='${tFullscreen}'/>" data-msg-exit-fullscreen="<c:out value='${tExitFullscreen}'/>">
  <div class="reader-bar"><a class="btn small" href="${ctx}/home"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg><fmt:message key="reader.back"/></a><span class="reader-title" title="<c:out value='${book.title}'/>"><c:out value="${book.title}"/></span><div class="reader-search"><label class="sr" for="searchInput"><c:out value="${tSearch}"/></label><input id="searchInput" type="search" placeholder="<c:out value='${tSearch}'/>" autocomplete="off"><button id="searchPrevBtn" type="button" class="btn small icon-only" aria-label="<fmt:message key='reader.prev'/>"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg></button><button id="searchNextBtn" type="button" class="btn small icon-only" aria-label="<fmt:message key='reader.next'/>"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></button><span id="searchStatus" class="search-status" aria-live="polite"></span></div>
    <div class="reader-nav" aria-label="<fmt:message key='reader.page'/>"><button id="prevBtn" type="button" class="btn small icon-only" title="<fmt:message key='reader.prev'/>" aria-label="<fmt:message key='reader.prev'/>"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg></button><label class="page-box"><span class="sr"><fmt:message key="reader.page"/></span><input id="pageInput" type="number" min="1" max="${book.pageCount}" value="${book.lastPage}"><span>/ <span id="pageTotal">${book.pageCount}</span></span></label><button id="nextBtn" type="button" class="btn small icon-only" title="<fmt:message key='reader.next'/>" aria-label="<fmt:message key='reader.next'/>"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></button></div>
    <div class="reader-zoom" aria-label="<fmt:message key='reader.zoomIn'/>"><button id="zoomOutBtn" type="button" class="btn small icon-only" title="<fmt:message key='reader.zoomOut'/>" aria-label="<fmt:message key='reader.zoomOut'/>"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/></svg></button><button id="zoomInBtn" type="button" class="btn small icon-only" title="<fmt:message key='reader.zoomIn'/>" aria-label="<fmt:message key='reader.zoomIn'/>"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></button><button id="fitWidthBtn" type="button" class="btn small icon-only" title="<fmt:message key='reader.fitWidth'/>" aria-label="<fmt:message key='reader.fitWidth'/>"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8V5h3M21 8V5h-3M3 16v3h3M21 16v3h-3"/><path d="M6 12h12"/></svg></button><button id="fitPageBtn" type="button" class="btn small icon-only" title="<fmt:message key='reader.fitPage'/>" aria-label="<fmt:message key='reader.fitPage'/>"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M8 21H5a2 2 0 0 1-2-2v-3M16 21h3a2 2 0 0 0 2-2v-3"/></svg></button><button id="fullscreenBtn" type="button" class="btn small icon-only" title="<c:out value='${tFullscreen}'/>" aria-label="<c:out value='${tFullscreen}'/>" aria-pressed="false"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M8 21H5a2 2 0 0 1-2-2v-3M16 21h3a2 2 0 0 0 2-2v-3"/></svg></button></div>
  </div><div id="stage" class="stage"><p id="status" class="status"><fmt:message key="reader.loading"/></p><div id="pageView" class="page-view"><canvas id="canvas" hidden></canvas><div id="textLayer" class="text-layer" aria-label="<c:out value='${book.title}'/>"></div></div></div>
</section><script type="module" src="${ctx}/static/js/reader.js"></script><%@ include file="_footer.jspf" %>
